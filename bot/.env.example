# Signal + Forager public fork env template.
# Do not commit `.env`.

# Local database paths. New forks start empty; db.init() creates schema.
SIGNAL_DB_PATH=bot.db
FORAGER_DB_PATH=../forager/forager_data.db
SIGNAL_PROFILE=paper

# Local LLM option (free, no API key)
FORAGER_OLLAMA_MODEL=qwen2.5:7b
FORAGER_OLLAMA_URL=http://localhost:11434

# Optional paid/quota providers. Use your own keys only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Optional free/signup integrations.
FRED_API_KEY=
METACULUS_API_TOKEN=
OPENFEC_API_KEY=
PROPUBLICA_API_KEY=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
ACLED_API_KEY=
ACLED_EMAIL=
ACLED_PASSWORD=

# Sizing / gates. Defaults are conservative paper-research settings.
BANKROLL_USD=1000
KELLY_FRACTION=0.25
BET_MIN_USD=1.0
BET_MAX_USD=30.0
MIN_VOLUME_USD=10000
MIN_DAYS_TO_RESOLUTION=7
MAX_DAYS_TO_RESOLUTION=180
EDGE_THRESHOLD=0.06
MAX_SONNET_MARKETS_PER_DAY=12
